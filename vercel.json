{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/v/:id",
      "destination": "/api/render?id=:id"
    },
    {
      "source": "/d/:id",
      "destination": "/api/render?kind=diagram&id=:id"
    },
    {
      "source": "/c",
      "destination": "/api/render?kind=collection"
    },
    {
      "source": "/c/:slug",
      "destination": "/api/render?kind=collection&slug=:slug"
    },
    {
      "source": "/raw/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/a/:id",
      "destination": "/api/archify-render?id=:id"
    },
    {
      "source": "/dashboard",
      "destination": "/api/dashboard"
    },
    {
      "source": "/settings",
      "destination": "/api/dashboard?view=settings"
    },
    {
      "source": "/guide",
      "destination": "/guide.html"
    }
  ]
}
